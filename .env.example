# ── Wit Tools Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Remove.bg API Key – required for BgRemover & PassportPhotoMaker tools
# Get your free key at: https://www.remove.bg/api
VITE_REMOVE_BG_API_KEY=your_remove_bg_api_key_here